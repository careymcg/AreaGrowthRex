tsplot<-ggplot(data = data.t,aes(x = as.numeric(Year),y=Value)) +
geom_line(aes(color = factor(Model)),linewidth = 1.5,alpha = 1) +
geom_ribbon(aes(ymin = lb,ymax = ub,fill = factor(Model)),alpha =0.2,show.legend = FALSE) +
labs(x=xlabel,y = ylabel,color = "Model") +
scale_color_viridis_d(aesthetics = c("colour","fill"),direction = -1) +
if (showlegend == "none") {
guides(color = showlegend) } else {
guides(col = guide_legend())
}
tsplot
plot_timeseries<-function(data.t,xlabel,ylabel,showlegend,viridis_direction = 1) {
tsplot<-ggplot(data = data.t,aes(x = as.numeric(Year),y=Value)) +
geom_line(aes(color = factor(Model)),linewidth = 1.5,alpha = 1) +
geom_ribbon(aes(ymin = lb,ymax = ub,fill = factor(Model)),alpha =0.2,show.legend = FALSE) +
labs(x=xlabel,y = ylabel,color = "Model") +
scale_color_viridis_d(aesthetics = c("colour","fill"),direction = -1) +
if (showlegend == "none") {
guides(color = showlegend) } else {
guides(col = guide_legend())
}
tsplot<-ggplot(data = data.t,aes(x = as.numeric(Year),y=Value)) +
geom_line(aes(color = factor(Model)),linewidth = 1.5,alpha = 1) +
geom_ribbon(aes(ymin = lb,ymax = ub,fill = factor(Model)),alpha =0.2,show.legend = FALSE) +
labs(x=xlabel,y = ylabel,color = "Model") +
scale_color_viridis_d(aesthetics = c("colour","fill"),direction = -1) +
if (showlegend == "none") {
guides(color = showlegend) } else {
guides(col = guide_legend())
}
tsplot
tsplot<-ggplot(data = data.t,aes(x = as.numeric(Year),y=Value)) +
geom_line(aes(color = factor(Model)),linewidth = 1.5,alpha = 1) +
geom_ribbon(aes(ymin = lb,ymax = ub,fill = factor(Model)),alpha =0.2,show.legend = FALSE) +
labs(x=xlabel,y = ylabel,color = "Model") +
scale_color_viridis_d(aesthetics = c("colour","fill"),direction = 1) +
if (showlegend == "none") {
guides(color = showlegend) } else {
guides(col = guide_legend())
}
tsplot
tsplot<-ggplot(data = data.t,aes(x = as.numeric(Year),y=Value)) +
geom_line(aes(color = factor(Model)),linewidth = 1.5,alpha = 1) +
geom_ribbon(aes(ymin = lb,ymax = ub,fill = factor(Model)),alpha =0.2,show.legend = FALSE) +
labs(x=xlabel,y = ylabel,color = "Model") +
scale_color_viridis_d(aesthetics = c("colour","fill"), option = "Cividis") +
if (showlegend == "none") {
guides(color = showlegend) } else {
guides(col = guide_legend())
}
