devtools::install_github("careymcg/AreaGrowthRex")
if (!requireNamespace("pacman", quietly = TRUE)) {
install.packages("pacman")
}
newlibs <-c('r4ss',
'dplyr',
'tidyr',
'here',
'ggplot2',
'keyring',
'DBI',
'odbc',
'afscISS',
'surveyISS',
'ggplot2',
'AreaGrowthRex')
pacman::p_load(char = newlibs) #load packages
compare_dir<-file.path(run_dir,"comparison_plots")
windows(record = T)
par(mfrow = c(1,1),cex.axis = 1.8, cex.lab = 1.8,lwd = 3,omi =c(0.3,0.1,0.3,0.3), mai = c(1.02,1,0.82,0.42),bty = "l")
species = "Rex"#"Halibut" #BSAI_flats #Dover #"Flathead" "Rex"
run_dir<-"C:/Users/carey.mcgilliard/Work/FlatfishAssessments/2026/goa_rex/runs"
the_run <- "run_19_as_for_18_includes_ageerr"
SS3PredDir = file.path(run_dir,the_run)
setwd(SS3PredDir) #this ends at the end of the chunk
previous_assess_dir<-"C:/Users/carey.mcgilliard/Work/FlatfishAssessments/2021/Rex/Runs"
WorkDir = "C:/Users/carey.mcgilliard/Work/"
CodeDir = "C:/GitProjects/newsbss/"
Uncertainty = T #make r4ss plots with or without uncertainty plotted
FirstYr = 1982 #This is important later for projections and the phase plot.
LastYr = 2026 #LastYr is the last year included in the ss3 model
RecruitmentAge = 3 #RecruitmentAge is the age of recruitment for projections, which are done using the spmR repo
NagesProject = 20 #NagesProject is the plus group age for projections, which is the same as the plus group in ss3
#r4ss, basic plot file, bias adjustment, and Francis lambdas
MyOutput = SS_output(dir = SS3PredDir,covar = Uncertainty,forecast=TRUE,printstats=FALSE)
SS_plots(replist = MyOutput,uncertainty=Uncertainty)
SSplotPars(replist = MyOutput,showpost = F,fitrange = T, nrow = 8,ncol = 4,pheight= 8,pwidth = 8)
#| label: setup
#| include: false
knitr::opts_knit$set(root.dir = SS3PredDir)
compare_dir<-file.path(run_dir,"comparison_plots")
if (!dir.exists(compare_dir)) {
dir.create(compare_dir, recursive = TRUE)
}
run_2021 <-file.path(run_dir,"run_2021_accepted_new_ss3v")
run_17 <- file.path(run_dir,"run_17_asfor7_newdata_excludes_2025_caal")
run_18 <- file.path(run_dir,"run_18_as_for_17_newdata_includes_2025_caal")
run_base<- file.path(run_dir,"run_19_as_for_18_includes_ageerr")
label_2021<-"2021 accepted"
label_17 <- "new data excludes 2025 caal"
label_18 <- "new data"
label_base <-"base model"
the_run_labels <-c(label_2021,label_17,label_18,label_base)
the_run_list<-r4ss::SSgetoutput(dirvec = c(run_2021,run_17,run_18,run_base),getcomp = TRUE, getcovar = TRUE)
#SummaryList<-r4ss::SSsummarize(MasterList)
#need to make y-axis on ssb go to zero
ssbplot<-AreaGrowthRex::plot_ssbs(ssruns=the_run_list,mlabel=the_run_labels,showxlabel =   FALSE,showlegend = "none",color_option = "cividis",color_direction =-1)
recplot<-AreaGrowthRex::plot_recs(ssruns = the_run_list,mlabel = the_run_labels,showxlabel = FALSE,showlegend = "none",color_option = "cividis",color_direction = -1)
fi_plot<-AreaGrowthRex::plot_one_minus_spr(ssruns = the_run_list,mlabel = the_run_labels,showxlabel = FALSE,showlegend = "yes",color_option = "cividis",color_direction = -1)
#stuff<-get_catch_data(ssruns = MasterList,mlabel = Mlabels)
total_catch_plot<-AreaGrowthRex::plot_total_catch(ssruns = the_run_list,mlabel = the_run_labels,showxlabel = TRUE,showlegend = "none")
#from library(patchwork)
bigfig<-(total_catch_plot/ssbplot/recplot/fi_plot)
